pipeline {
    agent any

    environment {
        VPS_HOST    = '172.19.0.1'
        VPS_USER    = 'leo'
        SSH_KEY     = '/var/jenkins_home/.ssh/id_rsa'
        SSH_OPTS    = '-o StrictHostKeyChecking=no -o BatchMode=yes'
        COMPOSE_DIR = '/home/leo/docker'
        APP_DIR     = '/home/leo/docker/excalidraw'
        API_DIR     = '/home/leo/docker/excalidraw-api'
    }

    stages {
        stage('📥 Sync código') {
            steps {
                sh '''#!/bin/bash
                    ssh -i "${SSH_KEY}" ${SSH_OPTS} ${VPS_USER}@${VPS_HOST} \
                        "rm -rf ${APP_DIR} && mkdir -p ${APP_DIR}"
                    tar --exclude=.git -cf - . | ssh -i "${SSH_KEY}" ${SSH_OPTS} ${VPS_USER}@${VPS_HOST} \
                        "tar xf - -C ${APP_DIR}"
                    ssh -i "${SSH_KEY}" ${SSH_OPTS} ${VPS_USER}@${VPS_HOST} \
                        "rm -rf ${API_DIR} && cp -r ${APP_DIR}/excalidraw-api ${API_DIR}"
                '''
            }
        }

        stage('🏗️ Build imagem') {
            steps {
                sh '''#!/bin/bash
                    ssh -i "${SSH_KEY}" ${SSH_OPTS} ${VPS_USER}@${VPS_HOST} \
                        "cd ${COMPOSE_DIR} && docker compose build excalidraw excalidraw-api"
                '''
            }
        }

        stage('🚀 Deploy') {
            steps {
                sh '''#!/bin/bash
                    ssh -i "${SSH_KEY}" ${SSH_OPTS} ${VPS_USER}@${VPS_HOST} \
                        "cd ${COMPOSE_DIR} && docker compose up -d excalidraw excalidraw-api"
                '''
            }
        }

        stage('🔍 Verificar') {
            steps {
                sh '''#!/bin/bash
                    sleep 20
                    HTTP_CODE=$(ssh -i "${SSH_KEY}" ${SSH_OPTS} ${VPS_USER}@${VPS_HOST} \
                        "curl -s -o /dev/null -w '%{http_code}' https://jaquesprojetos.com.br/excalidraw/")
                    if [ "$HTTP_CODE" != "302" ]; then
                        echo "ERRO: /excalidraw retornou $HTTP_CODE (esperado 302, redirecionando para login do Authelia)"
                        exit 1
                    fi
                    echo "✅ Deploy verificado (protegido por Authelia)!"
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Deploy do Excalidraw concluído! 🚀'
        }
        failure {
            echo '❌ Deploy do Excalidraw falhou!'
        }
    }
}
