pipeline {
    agent any

    environment {
        APP_DIR = '/home/leo/docker/excalidraw'
        API_DIR = '/home/leo/docker/excalidraw-api'
        COMPOSE_DIR = '/home/leo/docker'
    }

    stages {
        stage('📥 Sync código') {
            steps {
                sh '''
                    mkdir -p ${APP_DIR}
                    rsync -a --delete --exclude .git ./ ${APP_DIR}/

                    mkdir -p ${API_DIR}
                    rsync -a --delete ./excalidraw-api/ ${API_DIR}/
                '''
            }
        }

        stage('🏗️ Build imagem') {
            steps {
                sh 'cd ${COMPOSE_DIR} && docker compose build excalidraw excalidraw-api'
            }
        }

        stage('🚀 Deploy') {
            steps {
                sh 'cd ${COMPOSE_DIR} && docker compose up -d excalidraw excalidraw-api'
            }
        }

        stage('🔍 Verificar') {
            steps {
                sh '''
                    sleep 5
                    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" https://jaquesprojetos.com.br/excalidraw/)
                    if [ "$HTTP_CODE" != "302" ]; then
                        echo "ERRO: /excalidraw retornou $HTTP_CODE (esperado 302, redirecionando para login do Authelia)"
                        exit 1
                    fi
                    echo "✅ Deploy verificado (protegido por Authelia)!"
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Deploy do Excalidraw concluído! 🚀'
        }
        failure {
            echo '❌ Deploy do Excalidraw falhou!'
        }
    }
}
